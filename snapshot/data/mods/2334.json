  "name": "Animator Enabler",
  "slug": "animator-enabler",
  "teaser": "Common lib for modders adding animated objects",
  "thumbnail": "https://forge-static.sp-tarkov.com/mods/ZH9oeFcpybAfJqjzOYHSr6L1DIXF7TO1T07vWhGc.jpg",
