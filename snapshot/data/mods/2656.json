{
  "type": "mod",
  "id": 2656,
  "hub_id": null,
  "guid": "com.20fpsguy.quickloot",
  "name": "Quick Loot",
  "slug": "quick-loot",
  "teaser": "a mod that loots items with a press of a key!",
  "thumbnail": "https://forge-static.sp-tarkov.com/mods/Jcn1Ts9EcinOiZq4WDvDfJ1gmaj6xuDCGIWK7Y7C.png",
  "downloads": 1897,
  "favourites_count": 5,
  "description": "<p>Tired of manually picking through a scav’s pockets for ammo and meds? QuickLoot lets you grab exactly what you need with a single keypress.</p>\n<p>Open a body or container, press your hotkey, and the mod automatically transfers matching items straight to your inventory. No dragging, no clicking, just loot and go.</p>\n<div class=\"tabset\"><div id=\"tabset-1-panel-1\" class=\"tab-panel\"><div class=\"tab-title\">Features</div>\n<div class=\"tab-content\"><p><strong>Auto Search</strong></p>\n<p><strong>Quick sort</strong> sorts items only in the backpack from top to bottom  (default: G)</p>\n<p><strong>Configurable hotkey</strong> (default: F)</p>\n<p><strong>Category filters</strong> - choose what to auto-loot: Ammo, Meds, Food &amp; Drink, Barter items</p>\n<p><strong>High value filter</strong> - automatically grabs expensive items based on live flea market prices <em>(will be expanded in a future addon)</em></p>\n<p>All settings are available in the F12 BepInEx menu in-game.</p></div></div></div>\n\n",
  "detail_url": "https://forge.sp-tarkov.com/mod/2656/quick-loot",
  "fika_compatibility": false,
  "featured": false,
  "contains_ads": false,
  "contains_ai_content": true,
  "custom_ai_disclosure": "<p>AI was used to make the inRaid ui animation</p>\n",
