  "name": "Tarkov Craft Loader",
  "slug": "tarkov-craft-loader",
  "teaser": "Load custom hideout production recipes from JSON files without touching any code.",
  "thumbnail": "https://forge-static.sp-tarkov.com/mods/4Xed3kwQcj941yFdsZYWzOG16VqA1ADZXutamufL.png",
